<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<GridPane fx:id="rootGridPane" style="-fx-background-color: #D9F7F0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.internshala.connect4.Controller">
    <columnConstraints>
        <ColumnConstraints />
        <ColumnConstraints />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" />
        <RowConstraints />
    </rowConstraints>
    <Pane GridPane.columnSpan="2" />
    <Pane fx:id="insertedDiscPane" prefHeight="400.0" prefWidth="200.0" GridPane.rowIndex="1" />
    <VBox alignment="CENTER" style="-fx-background-color: #2B3B4C;" GridPane.columnIndex="1" GridPane.rowIndex="1">
        <TextField fx:id="playerOneTextField" alignment="CENTER" promptText="Enter Player One Name">
            <font>
                <Font name="System Italic" size="13.0" />
            </font>
            <VBox.margin>
                <Insets left="15.0" right="15.0" top="35.0" />
            </VBox.margin>
        </TextField>
        <TextField fx:id="playerTwoTextField" alignment="CENTER" prefHeight="26.0" prefWidth="175.0" promptText="Enter Player Two Name">
            <font>
                <Font name="System Italic" size="13.0" />
            </font>
            <VBox.margin>
                <Insets left="15.0" right="15.0" />
            </VBox.margin>
        </TextField>
        <Button fx:id="setNamesButton" mnemonicParsing="false" prefHeight="26.0" prefWidth="132.0" text="SetNames">
            <font>
                <Font size="13.0" />
            </font>
            <VBox.margin>
                <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
            </VBox.margin>
        </Button>
        <Label fx:id="PlayerNameLable" alignment="CENTER" prefHeight="40.0" prefWidth="200.0" text="Player One" textFill="WHITE">
            <font>
                <Font name="System Bold" size="29.0" />
            </font>
            <VBox.margin>
                <Insets top="70.0" />
            </VBox.margin>
        </Label>
        <Label alignment="CENTER" prefHeight="40.0" prefWidth="200.0" text="Turn" textFill="WHITE">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
        </Label>
        <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
    </VBox>
</GridPane>
